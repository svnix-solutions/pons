# ── Media plane environment (Phase 3) ──
# Copy to `.env` and fill in. TEMPLATE — values are placeholders.

# Shared secret the media bridge uses to call Pons POST /api/media/session.
# Must ALSO be set in the Next.js runtime env AND the Convex deployment env
# (convex/gateway.ts:attachCallSession reads it too). Generate a long random
# value, e.g. `openssl rand -hex 32`.
MEDIA_BRIDGE_SECRET=

# Base URL of the Pons deployment the bridge posts session updates to.
PONS_BASE_URL=https://pons.chat

# ── WhatsApp / Meta SIP trunk ──
# From Meta's SIP Configuration guide for your calling-enabled number.
META_SIP_SERVER=
META_SIP_USERNAME=
META_SIP_PASSWORD=
META_SIP_REALM=

# ── Dograh ──
# ARI connection Asterisk uses to hand calls to the Dograh Stasis app,
# and Dograh's own provider keys (BYO STT/LLM/TTS or speech-to-speech).
ARI_USERNAME=dograh
ARI_PASSWORD=
DOGRAH_STASIS_APP=dograh
DOGRAH_BASE_URL=http://dograh:8000
